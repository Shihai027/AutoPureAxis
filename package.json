{
  "name": "@local/dsh-speaker-axis",
  "version": "1.0.0",
  "private": true,
  "description": "Speaker-colored ASS timing files from video or audio, with no transcription or translation.",
  "type": "module",
  "bin": {
    "speaker-axis": "./bin/speaker-axis.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "index.js",
    "client.js",
    "core.js",
    "diarize.cjs",
    "bin/*.mjs",
    "docs/preview.png",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.1"
  }
}
